# DeepSeek API 配置示例
# 复制为 .env 或直接设为系统环境变量；也可写入 data/config.json（不要提交到公开仓库）

# 必填：在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：模型（默认 deepseek-flash，即 V4.1-Flash-1017；更强可用 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-flash

# 可选：网关地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=25

# 可选：开关（设为 0 可强制离线，用于断网评审）
REDORIGIN_LLM=1
REDORIGIN_SEARCH=1

# 可选：每次联网检索返回条数（1-50）
REDORIGIN_WEB_RESULTS=4
